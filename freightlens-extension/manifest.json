{
  "manifest_version": 3,
  "name": "FreightLens — Frachtangebote sofort bewerten",
  "version": "1.0.0",
  "description": "Bewerte Frachtangebote auf TIMOCOM in Echtzeit: Rentabilität, Marge, Kosten — direkt im Browser.",
  "minimum_chrome_version": "114",

  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],

  "host_permissions": [
    "https://*.timocom.com/*",
    "https://router.project-osrm.org/*",
    "https://nominatim.openstreetmap.org/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.timocom.com/*",
        "file:///*/demo.html"
      ],
      "js": [
        "shared/formatierung.js",
        "shared/nachrichten.js",
        "calculator/profilkonstanten.js",
        "calculator/tariffdaten.js",
        "calculator/kosten.js",
        "content/scraper.js",
        "content/badge-injector.js",
        "content/content-main.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
